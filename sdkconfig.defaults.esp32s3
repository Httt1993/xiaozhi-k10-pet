CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# Use an internal DMA bounce buffer so incomplete RGB frames can be rejected.
# Limit its size to preserve internal heap for AFE and WakeNet.
CONFIG_CAMERA_PSRAM_DMA=n
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
# Builtin TLSF pool in PSRAM (lvgl_psram_pool.h). Keep the base pool small
# enough for 2MB PSRAM boards; 8MB boards add extra pools in lcd_display.cc
# (chunked to LV_MEM_SIZE — TLSF rejects a single add_pool larger than this).
# Variants that set CONFIG_SPIRAM=n are switched back to CLIB malloc in
# scripts/build.py; do not repeat that override on each board.
CONFIG_LV_USE_BUILTIN_MALLOC=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_MEM_SIZE_KILOBYTES=1024

# ---- Core Dump：崩溃现场转储（走 UART，不占用分区表）----
# 为什么用 UART 而不是 Flash：
#   1) K10 大量使用 PSRAM，官方明确"任务栈在 PSRAM 时 Core Dump 存 flash 不可用"；
#   2) 现有分区表 partitions/v2/16m.csv 无 coredump 分区（16MB 已被 ota×2 + assets 占满），
#      要存 flash 必须改分区表，风险高。
# 崩溃时现场从串口输出，配合 serial_log.py 落盘；用 espcoredump.py 解析：
#   python $IDF_PATH/components/espcoredump/espcoredump.py info_corefile -t raw -c <dump>
# 注（IDF v6.1）：数据格式固定 ELF、校验固定 SHA256（原 DATA_FORMAT_ELF / CHECKSUM_CRC32
#   两个键已删除）；espcoredump 组件须在 main/CMakeLists.txt PRIV_REQUIRES 显式引入，
#   否则其 Kconfig 不进构建树，下面的键会被判 unknown symbol 而静默失效。
# 若日后想存 flash：需在分区表加 coredump 分区（data, coredump, 建议 256KB），再改回
#   CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y 并删掉下面 TO_UART 那行。
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_UART_DELAY=0
CONFIG_ESP_COREDUMP_LOGS=y
